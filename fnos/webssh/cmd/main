#!/bin/bash

LOG_FILE="${TRIM_PKGVAR}/info.log"
PID_FILE="${TRIM_PKGVAR}/app.pid"
DATA_DIR="${TRIM_DATA_SHARE_PATHS%%:*}"

export PATH="/var/apps/nodejs_v22/target/bin:$PATH"

# 端口三级优先级：settings.conf > wizard 向导 > TRIM_SERVICE_PORT > 默认 1314
if [ -f "${TRIM_PKGETC}/settings.conf" ]; then
    . "${TRIM_PKGETC}/settings.conf"
fi
PORT="${wizard_webssh_http_port:-${TRIM_SERVICE_PORT:-1314}}"

CMD="WEBSSH_HOST=0.0.0.0 WEBSSH_PROFILES_PATH=${DATA_DIR}/ssh-connections.json WEBSSH_PROFILES_KEY_PATH=${DATA_DIR}/ssh-connections.key PORT=${PORT} node ${TRIM_APPDEST}/server/server.js"

log_msg() {
    echo "$(date '+%Y-%m-%d %H:%M:%S') - $1" >> "${LOG_FILE}"
}

start_process() {
    if status; then return 0; fi
    log_msg "Starting WebSSH on port ${PORT} ..."
    bash -c "${CMD}" >> "${LOG_FILE}" 2>&1 &
    printf "%s" "$!" > "${PID_FILE}"
    return 0
}

stop_process() {
    log_msg "Stopping WebSSH ..."
    if [ -r "${PID_FILE}" ]; then
        pid=$(head -n 1 "${PID_FILE}" | tr -d '[:space:]')
        if ! kill -0 "${pid}" 2>/dev/null; then
            rm -f "${PID_FILE}"
            return 0
        fi
        kill -TERM "${pid}" >> "${LOG_FILE}" 2>&1
        local count=0
        while kill -0 "${pid}" 2>/dev/null && [ ${count} -lt 10 ]; do
            sleep 1
            count=$((count + 1))
        done
        kill -KILL "${pid}" 2>/dev/null
        rm -f "${PID_FILE}"
    fi
    return 0
}

status() {
    if [ -f "${PID_FILE}" ]; then
        pid=$(head -n 1 "${PID_FILE}" | tr -d '[:space:]')
        if kill -0 "${pid}" 2>/dev/null; then return 0; fi
        rm -f "${PID_FILE}"
    fi
    return 1
}

case "$1" in
    start)  start_process ;;
    stop)   stop_process ;;
    status) if status; then exit 0; else exit 3; fi ;;
    *)      exit 1 ;;
esac
